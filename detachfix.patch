From 7d416c0a9cb4e36b8d96afb0847ae06aa502d16a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 25 Jun 2026 15:08:09 +0000
Subject: [PATCH] Fix: keep repositioned elements attached to their parent (no
 detach)

liftToAbsolute previously reparented the dragged/resized element to the
design root via scope.appendChild(el). Visually the element stayed put,
but in the DOM it was detached from its container (e.g. a card), so
moving the card afterwards left the element behind.

Now the element is made position:absolute relative to its IMMEDIATE
parent and is NOT reparented. The parent is promoted to a positioning
context and offsetLeft/Top are read parent-relative. The element stays a
DOM child of its card, so moving the card moves it along with it.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CHmRfNf3vpjZKtRJu6e8uq
---
 .../canvas/shapes/generatedui/index.tsx       | 66 +++++++++----------
 1 file changed, 33 insertions(+), 33 deletions(-)

diff --git a/src/components/canvas/shapes/generatedui/index.tsx b/src/components/canvas/shapes/generatedui/index.tsx
index 07c5da3..b03793b 100644
--- a/src/components/canvas/shapes/generatedui/index.tsx
+++ b/src/components/canvas/shapes/generatedui/index.tsx
@@ -195,51 +195,50 @@ const GeneratedUI = ({ shape, toggleChat, generateWorkflow, exportDesign }: Prop
         const c = contentRef.current
         if (!c || el === c) return
         if (el.dataset.guiLifted === '1') return
-        // Reparent INTO the scoped design root (`[data-generated-ui]`) — not the
-        // outer content wrapper — so the design's scoped CSS (background/text
-        // colours like `[data-generated-ui] .c-bg{...}`) keeps applying. Moving
-        // the element outside that scope was stripping its background colour.
         const scope = (c.querySelector('[data-generated-ui]') as HTMLElement | null) || c
         if (el === scope) return
-        if (window.getComputedStyle(scope).position === 'static') scope.style.position = 'relative'
+        // Anchor the element to its IMMEDIATE parent instead of reparenting it to
+        // the design root. The element stays a DOM child of (e.g.) its card, so
+        // moving the card later moves this element along with it — it never
+        // "detaches". The parent becomes the positioning context for the now
+        // absolute child; because we don't move it out of `[data-generated-ui]`,
+        // the design's scoped CSS (e.g. `[data-generated-ui] .c-bg{...}`) keeps
+        // applying too.
+        const parent = el.parentElement
+        if (!parent || parent === el) return
         // keep the design box from collapsing as elements leave the flow
         if (!c.style.minHeight) c.style.minHeight = c.offsetHeight + 'px'
-        // offset of el relative to the scope root
-        let x = 0
-        let y = 0
-        let node: HTMLElement | null = el
-        while (node && node !== scope) {
-            x += node.offsetLeft
-            y += node.offsetTop
-            node = node.offsetParent as HTMLElement | null
-        }
+        // Make the parent a positioning context so the child's absolute left/top
+        // resolve relative to THIS parent — and so that `offsetLeft/Top` read
+        // below are parent-relative (parent becomes el's offsetParent).
+        if (window.getComputedStyle(parent).position === 'static') parent.style.position = 'relative'
+        // Position of el WITHIN its parent (measured while still in normal flow).
+        const x = el.offsetLeft
+        const y = el.offsetTop
         const w = el.offsetWidth
         const h = el.offsetHeight
         const elCs = window.getComputedStyle(el)
-        // Freeze inherited text properties (esp. colour) inline BEFORE reparenting,
-        // so a black text whose colour was inherited from its old parent doesn't
-        // flip to the scope root's default (white) once it's moved out.
+        // Freeze inherited text properties (esp. colour) inline, so a value that
+        // was inherited from an ancestor doesn't change once el leaves the flow.
         ;(['color', 'fontFamily', 'fontWeight', 'fontStyle', 'textAlign', 'letterSpacing', 'textTransform'] as const).forEach(
             (p) => {
                 if (!el.style[p]) el.style[p] = elCs[p]
             }
         )
-        // Leave an invisible placeholder so the surrounding elements keep their
+        // Leave an invisible placeholder so the surrounding siblings keep their
         // original positions (nothing reflows when this element pops out).
-        if (el.parentElement) {
-            const ph = document.createElement('div')
-            const phId = 'ph-' + Math.random().toString(36).slice(2)
-            ph.setAttribute('data-gui-ph', phId)
-            ph.style.width = w + 'px'
-            ph.style.height = h + 'px'
-            ph.style.margin = elCs.margin
-            ph.style.flex = elCs.flex && elCs.flex !== '0 1 auto' ? elCs.flex : ''
-            ph.style.display = elCs.display === 'inline' ? 'inline-block' : elCs.display
-            ph.style.visibility = 'hidden'
-            ph.style.pointerEvents = 'none'
-            el.dataset.guiPh = phId
-            el.parentElement.insertBefore(ph, el)
-        }
+        const ph = document.createElement('div')
+        const phId = 'ph-' + Math.random().toString(36).slice(2)
+        ph.setAttribute('data-gui-ph', phId)
+        ph.style.width = w + 'px'
+        ph.style.height = h + 'px'
+        ph.style.margin = elCs.margin
+        ph.style.flex = elCs.flex && elCs.flex !== '0 1 auto' ? elCs.flex : ''
+        ph.style.display = elCs.display === 'inline' ? 'inline-block' : elCs.display
+        ph.style.visibility = 'hidden'
+        ph.style.pointerEvents = 'none'
+        el.dataset.guiPh = phId
+        parent.insertBefore(ph, el)
         el.style.boxSizing = 'border-box'
         el.style.margin = '0'
         el.style.position = 'absolute'
@@ -253,7 +252,8 @@ const GeneratedUI = ({ shape, toggleChat, generateWorkflow, exportDesign }: Prop
         // Use the Back button to push something (e.g. a big background) behind.
         el.style.zIndex = el.dataset.guiZ || '1'
         el.dataset.guiLifted = '1'
-        scope.appendChild(el) // reparent within the scoped root so its CSS still applies
+        // NOTE: el is deliberately NOT reparented — it stays inside `parent` so
+        // it keeps moving together with its container (the detach fix).
         computeOverlay(el)
     }
 
