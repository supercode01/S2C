+// Base z-index for elements lifted out of flow. AI designs use Tailwind z
+// classes (z-10/z-20/z-50 …) on their sections/cards, so a dragged element with
+// a small z-index would render BEHIND those sections. Stacking lifted elements
+// well above that range keeps a just-moved/resized element visible instead of
+// disappearing behind the design. The per-element document order is preserved as
+// a small offset added on top of this base.
+const LIFT_BASE = 100000
+const liftZ = (offset: number) => String(LIFT_BASE + (Number.isFinite(offset) ? offset : 1))
+
